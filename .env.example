ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-a-long-random-string

# Data (products, orders, settings…): Upstash Redis, free plan. Created from
# the Vercel project's Storage tab (Marketplace → Upstash → Redis), which adds
# KV_REST_API_URL / KV_REST_API_TOKEN to the project automatically; pull them
# locally with: vercel env pull .env.local
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN work too.)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Images: Cloudinary, free plan. Dashboard → Settings → API Keys.
# (A single CLOUDINARY_URL=cloudinary://key:secret@cloud works too.)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Legacy: the old Vercel Blob store, only needed for the one-time copy of its
# data and images (scripts/migrate-from-blob.mjs).
BLOB_READ_WRITE_TOKEN=

# From the Stripe dashboard (Developers > API keys). Use test-mode keys
# (sk_test_… / pk_test_…) until you're ready to go live. Checkout returns a
# clear "not configured" error to shoppers if these are left blank.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# From the Stripe dashboard once you create a webhook endpoint pointing at
# <your-domain>/api/webhooks/stripe, listening for checkout.session.completed.
STRIPE_WEBHOOK_SECRET=

# Flat shipping rates in cents, charged in addition to item prices.
NEXT_PUBLIC_SHIPPING_RATE_FRANCE_CENTS=590
NEXT_PUBLIC_SHIPPING_RATE_INTL_CENTS=1890

# Absolute site URL, used to build Stripe's success/cancel redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
